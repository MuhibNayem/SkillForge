# Root .env — picked up automatically by docker-compose
# Copy this file and fill in real values before running `docker compose up`

# ── Auth / JWT ────────────────────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-here

# ── AI Service (Z.AI) ─────────────────────────────────────────────────────────
ZAI_API_KEY=your-zai-api-key-here

# ── Email (optional — notification-service) ───────────────────────────────────
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@skillforge.io
